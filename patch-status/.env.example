# Copy to .env (don't commit it). Real environment variables win over this file.
# Several subscriptions: comma-separated. Ignored if patch-status.toml lists subscriptions.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000,11111111-1111-1111-1111-111111111111

# Optional: use a config file somewhere other than ./patch-status.toml
# PATCH_STATUS_CONFIG=config/prod.toml

# Optional: service principal for DefaultAzureCredential instead of `az login`
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
